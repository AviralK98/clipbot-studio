# Local defaults only; change password and signing key before exposing this service.
APP_ENV=development
ADMIN_PASSWORD=clipbot-local
SESSION_SECRET=local-development-secret-change-before-deployment
API_TOKEN=
WEB_ORIGIN=http://localhost:3000
DEMO_MODE=false
AUTOPILOT=true
STOP_ALL_POSTING=false
DATABASE_URL=sqlite:///./data/clipbot.db
POSTGRES_PASSWORD=clipbot-local-db
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=./data/media
PUBLIC_MEDIA_BASE_URL=
SOURCE_DIRECTORY=./data/sources
VIZARD_API_KEY=
VIZARD_MODEL=clip_v1
OPUS_API_KEY=
OPUS_ORG_ID=
OPUS_MODEL=ClipBasic
# Official docs disagree about Opus timeRanges units. Confirm with a live fixture.
OPUS_TIME_RANGE_UNIT=unknown
# Free local review; optional paid alternatives: openai or anthropic
LLM_PROVIDER=local
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=private
YOUTUBE_DATA_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v25.0
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
MAX_SOURCE_MINUTES_PER_DAY=120
MAX_CLIPS_PER_DAY=20
MAX_VIZARD_CREDITS_PER_DAY=150
MAX_OPUS_CREDITS_PER_DAY=150
MAX_AI_COST_PER_DAY=5
# Set conservative upper-bound rates from your actual contracts, in USD.
VIZARD_COST_PER_CREDIT=0
OPUS_COST_PER_CREDIT=0
AI_INPUT_USD_PER_MILLION=1
AI_OUTPUT_USD_PER_MILLION=5
AI_CALL_RESERVATION_USD=0.10
STORAGE_USD_PER_GB_MONTH=0
TIMEZONE=Europe/London
POSTING_TIMES=09:00,14:00,19:00
MAX_POSTS_PER_PLATFORM_PER_DAY=3
MIN_POST_INTERVAL_MINUTES=180
N8N_ENCRYPTION_KEY=local-n8n-key-change-before-deployment

PUBLIC_API_BASE_URL=
OPUS_WEBHOOK_SECRET=
